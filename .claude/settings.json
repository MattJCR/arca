{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:pret.github.io)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"./.claude/hooks/lint-and-format.sh\"" },
          { "type": "command", "command": "\"./.claude/hooks/typecheck.sh\"" },
          { "type": "command", "command": "\"./.claude/hooks/test-runner.sh\"" },
          { "type": "command", "command": "\"./.claude/hooks/english-only-lint.sh\"" },
          { "type": "command", "command": "\"./.claude/hooks/i18n-key-lint.sh\"" },
          { "type": "command", "command": "\"./.claude/hooks/event-schema-check.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"./.claude/hooks/secret-scan.sh\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "\"./.claude/hooks/require-checkpoint.sh\"",
            "args": []
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"./.claude/checkpoint.md\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
